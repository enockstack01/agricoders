{
  "expo": {
    "name": "Planner",
    "slug": "planner",
    "owner": "enockstack",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "planner",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agricoders.planner"
    },
    "android": {
      "package": "com.agricoders.planner",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#1B5E20"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1B5E20",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0c140d"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      ["expo-image-picker", { "photosPermission": "Planner uses your photos so you can add your company logo to the cover page of your business plan." }],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
